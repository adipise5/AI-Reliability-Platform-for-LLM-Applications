    "/api/v1/datasets/{dataset_id}/items:bulk": {
      "post": {
        "tags": [
          "datasets"
        ],
        "summary": "Bulk Import Items",
        "operationId": "bulk_import_items_api_v1_datasets__dataset_id__items_bulk_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
