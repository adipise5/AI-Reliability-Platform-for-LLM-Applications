          "text": {
            "type": "string",
            "title": "Text"
          },
          "verdict": {
            "type": "string",
            "title": "Verdict"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
