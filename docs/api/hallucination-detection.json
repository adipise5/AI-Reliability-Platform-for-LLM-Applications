            "title": "Faithfulness Score"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "org_id",
          "response",
          "context",
          "claims",
          "faithfulness_score",
          "created_at"
