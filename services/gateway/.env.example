# Leave this set for a Gateway-only smoke test with no other services
# running. Clear it to use the real Authentication Service instead — see
# ADR-0003 and GATEWAY_AUTH_SERVICE_URL below.
GATEWAY_STATIC_API_KEYS=dev-local-key

# Only used when GATEWAY_STATIC_API_KEYS is empty. Defaults to the
# `auth` service name on the docker-compose network.
GATEWAY_AUTH_SERVICE_URL=http://auth:8000
GATEWAY_AUTH_SERVICE_TIMEOUT_SECONDS=5

GATEWAY_ANTHROPIC_API_KEY=
GATEWAY_OPENAI_API_KEY=
GATEWAY_GEMINI_API_KEY=

# Local Ollama daemon; no key required.
GATEWAY_OLLAMA_BASE_URL=http://localhost:11434

GATEWAY_REQUEST_TIMEOUT_SECONDS=60

GATEWAY_TRACE_COLLECTOR_URL=http://trace-collector:8000
GATEWAY_TRACE_COLLECTOR_TIMEOUT_SECONDS=5

GATEWAY_COST_ANALYTICS_URL=http://cost-analytics:8000
GATEWAY_COST_ANALYTICS_TIMEOUT_SECONDS=5
