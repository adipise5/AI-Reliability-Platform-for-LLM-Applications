AUTH_DATABASE_URL=postgresql+asyncpg://auth:auth@localhost:5432/arp

# Change this in any environment other than local dev.
AUTH_JWT_SECRET=dev-only-insecure-secret-change-me
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_TTL_SECONDS=3600

AUTH_API_KEY_ENVIRONMENT=live

# JSON list — origins the React Dashboard's dev server is served from.
AUTH_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
