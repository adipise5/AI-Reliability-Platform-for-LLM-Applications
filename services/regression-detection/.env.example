REGRESSION_DATABASE_URL=postgresql+asyncpg://regression:regression@localhost:5432/arp
REGRESSION_AUTH_SERVICE_URL=http://auth:8000
REGRESSION_EVALUATION_ENGINE_URL=http://evaluation-engine:8000
REGRESSION_TRACE_COLLECTOR_URL=http://trace-collector:8000
REGRESSION_UPSTREAM_TIMEOUT_SECONDS=30
REGRESSION_FAIL_THRESHOLD_STDDEV=2.0
